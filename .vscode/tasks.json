{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ansible: install",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/install-requirements && ${workspaceFolder}/scripts/install-ansible",
      "problemMatcher": []
    },
    {
      "label": "ansible: lint",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ansible-lint",
      "problemMatcher": [
        {
          "owner": "yamllint",
          "fileLocation": "absolute",
          "severity": "error",
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+): \\[(error|warning)\\] (.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        },
        {
          "owner": "ansible-lint",
          "fileLocation": "absolute",
          "pattern": [
            {
              "regexp": "^([\\w-]+(?:\\[[\\w-]+\\])?): (.+)$",
              "message": 2
            },
            {
              "regexp": "^(.+):(\\d+)(?::(\\d+))? Task/Handler:",
              "file": 1,
              "line": 2,
              "column": 3
            }
          ]
        }
      ]
    },
    {
      "label": "ansible: deploy to host",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy.py",
      "args": [
        "--host",
        "${input:targetHost}",
        "--recreate",
        "${input:recreateVolumes}"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
    },
    {
      "label": "ansible: provision user",
      "type": "process",
      "command": "${workspaceFolder}/scripts/deploy.py",
      "args": [
        "--host",
        "${input:targetHost}",
        "--provision-user",
        "${input:provisionUser}",
        "--provision-email",
        "${input:provisionEmail}",
        "--provision-password",
        "${input:provisionPassword}"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "ansible: provision administrator",
      "type": "process",
      "command": "${workspaceFolder}/scripts/deploy.py",
      "args": [
        "--host",
        "${input:targetHost}",
        "--provision-user",
        "${input:provisionUser}",
        "--provision-email",
        "${input:provisionEmail}",
        "--provision-password",
        "${input:provisionPassword}",
        "--provision-admin"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ],
  "inputs": [
    {
      "id": "targetHost",
      "type": "promptString",
      "description": "Enter the target host for Ansible playbook execution",
      "default": "localhost"
    },
    {
      "id": "recreateVolumes",
      "type": "pickString",
      "description": "Recreate volumes (true|false)",
      "options": [
        "true",
        "false"
      ],
      "default": "false"
    },
    {
      "id": "provisionUser",
      "type": "promptString",
      "description": "Enter the username to provision",
      "default": "newuser"
    },
    {
      "id": "provisionEmail",
      "type": "promptString",
      "description": "Enter the email to provision",
      "default": "user@example.com"
    },
    {
      "id": "provisionPassword",
      "type": "promptString",
      "description": "Enter the password to provision",
      "password": false
    }
  ]
}
