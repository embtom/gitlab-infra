FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
ARG GITLAB_RUNNER_VERSION

RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  bash \
  gpg \
  tini && \
  rm -rf /var/lib/apt/lists/*

COPY scripts/install-gitlab-runner /usr/local/bin/install-gitlab-runner
RUN chmod 0755 /usr/local/bin/install-gitlab-runner && \
  /usr/local/bin/install-gitlab-runner "${GITLAB_RUNNER_VERSION}"

RUN mkdir -p /etc/gitlab-runner /builds /cache /opt/gitlab-runner

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["/usr/bin/gitlab-runner", "run", \
  "--working-directory", "/opt/gitlab-runner", \
  "--config", "/etc/gitlab-runner/config.toml"]
