FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
ARG GITLAB_RUNNER_VERSION

RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  bash \
  tini && \
  rm -rf /var/lib/apt/lists/*

RUN for runner_url in \
  "https://gitlab-runner-downloads.s3.amazonaws.com/v${GITLAB_RUNNER_VERSION}/binaries/gitlab-runner-linux-amd64" \
  "https://gitlab-runner-downloads.s3.amazonaws.com/${GITLAB_RUNNER_VERSION}/binaries/gitlab-runner-linux-amd64"; do \
    if curl -fsSL "${runner_url}" -o /usr/local/bin/gitlab-runner; then \
      chmod +x /usr/local/bin/gitlab-runner; \
      exit 0; \
    fi; \
  done; \
  exit 1

RUN mkdir -p /etc/gitlab-runner /builds /cache /opt/gitlab-runner

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["/usr/local/bin/gitlab-runner", "run", \
  "--working-directory", "/opt/gitlab-runner", \
  "--config", "/etc/gitlab-runner/config.toml"]
