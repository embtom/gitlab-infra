FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
ARG GITLAB_RUNNER_VERSION

RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  bash \
  tini && \
  rm -rf /var/lib/apt/lists/*

RUN runner_downloaded=0; \
  for runner_url in \
  "https://s3.dualstack.us-east-1.amazonaws.com/gitlab-runner-downloads/v${GITLAB_RUNNER_VERSION}/binaries/gitlab-runner-linux-amd64" \
  "https://s3.dualstack.us-east-1.amazonaws.com/gitlab-runner-downloads/${GITLAB_RUNNER_VERSION}/binaries/gitlab-runner-linux-amd64"; do \
    if curl -fsSL "${runner_url}" -o /usr/local/bin/gitlab-runner; then \
      if curl -fsSL "${runner_url}.sha256" -o /tmp/gitlab-runner.sha256; then \
        checksum_line="$(tr -d '\r' </tmp/gitlab-runner.sha256 | head -n 1)"; \
        rm -f /tmp/gitlab-runner.sha256; \
        expected_hash="$(printf '%s\n' "${checksum_line}" | awk '{print $1}')"; \
      else \
        rm -f /usr/local/bin/gitlab-runner; \
        rm -f /tmp/gitlab-runner.sha256; \
        continue; \
      fi; \
      if ! printf '%s\n' "${expected_hash}" | grep -Eq '^[0-9a-fA-F]{64}$'; then \
        rm -f /usr/local/bin/gitlab-runner; \
        continue; \
      fi; \
      actual_hash="$(sha256sum /usr/local/bin/gitlab-runner | awk '{print $1}')"; \
      if [ -n "${expected_hash}" ] && [ "${actual_hash}" = "${expected_hash}" ]; then \
        chmod +x /usr/local/bin/gitlab-runner; \
        runner_downloaded=1; \
        break; \
      fi; \
      rm -f /usr/local/bin/gitlab-runner; \
    else \
      rm -f /usr/local/bin/gitlab-runner; \
    fi; \
  done; \
  test "${runner_downloaded}" -eq 1

RUN mkdir -p /etc/gitlab-runner /builds /cache /opt/gitlab-runner

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["/usr/local/bin/gitlab-runner", "run", \
  "--working-directory", "/opt/gitlab-runner", \
  "--config", "/etc/gitlab-runner/config.toml"]
