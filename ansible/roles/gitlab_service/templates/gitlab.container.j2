[Container]
Image={{ gitlab_service_image }}
ContainerName={{ gitlab_service_name }}
HostName={{ gitlab_service_name }}

Volume={{ gitlab_service_config_dir }}:/etc/gitlab
Volume={{ gitlab_service_logs_dir }}:/var/log/gitlab
Volume={{ gitlab_service_data_dir }}:/var/opt/gitlab

PublishPort={{ gitlab_service_web_port }}:{{ gitlab_service_web_port }}
PublishPort={{ gitlab_service_ssh_port }}:22
{% if gitlab_service_registry_enabled | bool %}
PublishPort={{ gitlab_service_registry_port }}:{{ gitlab_service_registry_port }}
{% endif %}
Network={{ gitlab_service_net }}

[Service]
Restart=always
# GitLab's own bootstrap (reconfigure + service startup) can take several
# minutes on first run; the systemd default (90s) is too short and would
# have systemd kill the unit before GitLab finishes starting.
TimeoutStartSec=300

[Install]
WantedBy=default.target
