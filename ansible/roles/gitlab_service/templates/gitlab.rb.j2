## Source: ansible/roles/gitlab_service/templates/gitlab.rb.j2
## To change settings, edit the template and re-run the deploy playbook;
## GitLab picks this up on its next `gitlab-ctl reconfigure` (container restart).

external_url 'https://{{ gitlab_service_external_host }}:{{ gitlab_service_web_port }}/'
gitlab_rails['nginx']['ssl_certificate'] = '{{ gitlab_service_tls_container_certificate }}'
gitlab_rails['nginx']['ssl_certificate_key'] = '{{ gitlab_service_tls_container_private_key }}'
# We supply our own PKI-issued cert/key, so don't let Chef manage the SSL dir.
letsencrypt['enable'] = false

gitlab_rails['env'] = {
  'GITLAB_LOG_LEVEL' => '{{ gitlab_service_log_level }}'
}

gitlab_rails['ldap_enabled'] = {{ gitlab_service_ldap.enabled | bool | to_json }}

{% if gitlab_service_ldap.enabled | bool %}
gitlab_rails['ldap_servers'] = {
  'main' => {
    'label' => {{ gitlab_service_ldap.label | to_json }},
    'host' => {{ gitlab_service_ldap.host | to_json }},
    'port' => {{ gitlab_service_ldap.port }},
    'uid' => {{ gitlab_service_ldap.uid | to_json }},
    'bind_dn' => {{ gitlab_service_ldap.bind_dn | to_json }},
    'password' => {{ gitlab_service_ldap.bind_password | to_json }},
    'encryption' => {{ gitlab_service_ldap.encryption | to_json }},
    'verify_certificates' => {{ gitlab_service_ldap.verify_certificates | to_json }},
    'ca_file' => {{ gitlab_service_ldap.ca_file | to_json }},
    'base' => {{ gitlab_service_ldap.base | to_json }},
    'user_filter' => {{ gitlab_service_ldap.user_filter | to_json }},
    'allow_username_or_email_login' => {{ gitlab_service_ldap.allow_username_or_email_login | to_json }},
    'attributes' => {
      'username' => [{{ gitlab_service_ldap.uid | to_json }}],
      'email' => ['mail'],
      'name' => ['cn', 'displayName'],
      'first_name' => ['givenName'],
      'last_name' => ['sn']
    }
  }
}
{% else %}
gitlab_rails['ldap_servers'] = {}
{% endif %}

# Only takes effect on the very first reconfigure of a fresh instance (root
# username stays 'root' - GitLab has no setting to change its email).
{# gitlab_rails['initial_root_password'] = '{{ gitlab_service_root_password }}' #}

# GitLab listens on port 22 in the container; Quadlet publishes the configured
# host port and GitLab must use it when generating SSH clone URLs.
gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_service_ssh_port }}

# Log rotation
logging['logrotate_frequency'] = 'daily'
logging['logrotate_rotate'] = 30
logging['logrotate_compress'] = 'compress'

# Container registry settings
{% if gitlab_service_registry_enabled | bool %}
registry_external_url 'https://{{ gitlab_service_external_host }}:{{ gitlab_service_registry_port }}'
gitlab_rails['registry_enabled'] = true
registry['enable'] = true
registry['storage'] = {
  'filesystem' => {
    'rootdirectory' => '/var/opt/gitlab/gitlab-rails/shared/registry'
  }
}
registry['nginx']['ssl_certificate'] = '{{ gitlab_service_tls_container_certificate }}'
registry['nginx']['ssl_certificate_key'] = '{{ gitlab_service_tls_container_private_key }}'
{% else %}
gitlab_rails['registry_enabled'] = false
registry['enable'] = false
{% endif %}
