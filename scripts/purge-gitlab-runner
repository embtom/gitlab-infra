#!/usr/bin/env bash

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "ERROR: This script must be run as root (use sudo)." >&2
  exit 1
fi

gitlab_runner_user="${1:-gitlab-runner}"
service_name="${2:-gitlab-runner.service}"
runner_config_dir="${3:-/var/lib/gitlab-runner/config}"
runner_builds_dir="${4:-/var/lib/gitlab-runner/builds}"

if ! id "$gitlab_runner_user" >/dev/null 2>&1; then
  echo "ERROR: User '$gitlab_runner_user' does not exist." >&2
  exit 1
fi

read -rp \
  "==> This will permanently delete user '$gitlab_runner_user', runner configuration, builds, and ALL associated Podman resources. Continue? [y/N] " \
  confirm

case "${confirm,,}" in
y | yes) ;;
*)
  echo "Aborted."
  exit 0
  ;;
esac

echo
echo "==> Stopping runner service and cleaning Podman resources"

sudo -u "$gitlab_runner_user" -i bash <<EOF
set +e

systemctl --user stop "$service_name"
systemctl --user disable "$service_name"
systemctl --user stop podman.socket
systemctl --user disable podman.socket

podman rm -af
podman rmi -af

podman volume ls -q | xargs -r podman volume rm
podman secret ls -q | xargs -r podman secret rm

podman network ls --format '{{.Name}}' \
    | grep -v '^podman$' \
    | xargs -r podman network rm

exit 0
EOF

echo
echo "==> Terminating user session"

loginctl disable-linger "$gitlab_runner_user" 2>/dev/null || true
loginctl terminate-user "$gitlab_runner_user" 2>/dev/null || true
pkill -KILL -u "$gitlab_runner_user" 2>/dev/null || true

echo
echo "==> Removing user '$gitlab_runner_user'"

userdel -r "$gitlab_runner_user"

echo
for runner_storage_dir in "$runner_config_dir" "$runner_builds_dir"; do
  echo "==> Removing runner storage directory '$runner_storage_dir'"

  resolved_storage_dir="$(realpath -m -- "$runner_storage_dir")"
  if [[ -z "$resolved_storage_dir" || "$resolved_storage_dir" == "/" ]]; then
    echo "ERROR: Refusing to remove unsafe storage directory: '$runner_storage_dir'" >&2
    exit 1
  fi

  rm -rf -- "$resolved_storage_dir"
done

echo
echo "==> Cleanup complete. Remove the stale runner in GitLab if it is no longer needed."
