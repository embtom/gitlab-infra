#!/usr/bin/env bash

set -euo pipefail

# Must run as root
if [[ $EUID -ne 0 ]]; then
  echo "ERROR: This script must be run as root (use sudo)." >&2
  exit 1
fi

gitlab_service_user="${1:-gitlab}"
SERVICE_NAME="${2:-gitlab.service}"
GITLAB_CONFIG_DIR="${3:-/var/lib/gitlab/config}"
GITLAB_LOGS_DIR="${4:-/var/lib/gitlab/logs}"
GITLAB_DATA_DIR="${5:-/var/lib/gitlab/data}"

#
# Verify that the user exists.
#
if ! id "$gitlab_service_user" >/dev/null 2>&1; then
  echo "ERROR: User '$gitlab_service_user' does not exist." >&2
  exit 1
fi

#
# Confirm the action with the user.
#

read -rp \
  "==> This will permanently delete user '$gitlab_service_user', GitLab storage directories, and ALL associated Podman resources. Continue? [y/N] " \
  confirm

case "${confirm,,}" in
y | yes) ;;
*)
  echo "Aborted."
  exit 0
  ;;
esac

echo
echo "==> Stopping user service and cleaning Podman resources"

sudo -u "$gitlab_service_user" -i bash <<EOF
set +e

systemctl --user stop "$SERVICE_NAME"
systemctl --user disable "$SERVICE_NAME"

podman rm -af
podman rmi -af

podman volume ls -q | xargs -r podman volume rm
podman secret ls -q | xargs -r podman secret rm

# Remove all custom networks but keep the default one.
podman network ls --format '{{.Name}}' \
    | grep -v '^podman$' \
    | xargs -r podman network rm

exit 0
EOF

echo
echo "==> Terminating user session"

loginctl disable-linger "$gitlab_service_user" 2>/dev/null || true
loginctl terminate-user "$gitlab_service_user" 2>/dev/null || true

sleep 1

pkill -KILL -u "$gitlab_service_user" 2>/dev/null || true

sleep 1

echo
echo "==> Removing user '$gitlab_service_user'"

userdel -r "$gitlab_service_user"

echo
for gitlab_storage_dir in "$GITLAB_CONFIG_DIR" "$GITLAB_LOGS_DIR" "$GITLAB_DATA_DIR"; do
  echo "==> Removing GitLab storage directory '$gitlab_storage_dir'"

  resolved_storage_dir="$(realpath -m -- "$gitlab_storage_dir")"
  if [[ -z "$resolved_storage_dir" || "$resolved_storage_dir" == "/" ]]; then
    echo "ERROR: Refusing to remove unsafe storage directory: '$gitlab_storage_dir'" >&2
    exit 1
  fi

  rm -rf -- "$resolved_storage_dir"
done

echo
echo "==> Cleanup complete."
